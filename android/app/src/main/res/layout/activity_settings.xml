<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Model Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Model Path"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etModelPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="/path/to/model"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Models Directory"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etModelsDir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="/path/to/models"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Server Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Port"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="8080"
            android:inputType="number"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Threads"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etThreads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="4"
            android:inputType="number"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Backend"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etBackend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="auto"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switchFlashAttention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flash Attention"
            android:checked="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generation Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Max Tokens"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etMaxTokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="4096"
            android:inputType="number"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Top P"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etTopP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.9"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Temperature"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.7"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Security"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API Key (optional)"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings" />

    </LinearLayout>

</ScrollView>
